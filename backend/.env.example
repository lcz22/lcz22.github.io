# Copy to .env and fill in the real database when it is ready.
# SQLite is used only to verify the API contract locally.
DATABASE_URL=sqlite+aiosqlite:///./hdu_sidequests.db

# PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://user:password@127.0.0.1:5432/hdu_sidequests
# MySQL example:
# DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/hdu_sidequests?charset=utf8mb4

# Public URL of this API, used for image URLs.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# The public URL of the frontend. Seed preset images are served from here.
FRONTEND_BASE_URL=http://127.0.0.1:4173

# Local image directory. Use an absolute path on the server if needed.
UPLOAD_DIR=./uploads

# Comma-separated frontend origins.
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8000,http://localhost:8000,https://lcz22.github.io

MAX_UPLOAD_BYTES=20971520
MAX_MOTION_BYTES=62914560
MAX_IMAGE_SIDE=1800
JPEG_QUALITY=84

# Change this before deploying. Use a long random string.
JWT_SECRET=local-dev-only-change-this-secret-before-deploy-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALLOW_REGISTRATION=true

# true: uploads are public immediately; false: status="pending" for admin review.
AUTO_APPROVE=false
